# Render supplies PORT automatically. For local development only:
PORT=3000
NODE_ENV=development

# Exact frontend origin, e.g. http://127.0.0.1:5500 or https://YOURNAME.github.io
FRONTEND_URL=http://127.0.0.1:5500

# Resend API key (never put this in frontend code)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
# Must be a sender allowed by Resend. onboarding@resend.dev is for testing to your own verified address.
EMAIL_FROM=MyProfile Security <onboarding@resend.dev>

# Firebase Admin service-account JSON, all on one line. Create a service account in Firebase/Google Cloud.
FIREBASE_SERVICE_ACCOUNT_JSON={}

# Generate a long random secret. Used to sign the short-lived post-MFA session token.
SESSION_SECRET=replace_with_a_long_random_secret_at_least_32_characters
